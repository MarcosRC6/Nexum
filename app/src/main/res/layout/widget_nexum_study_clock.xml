<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_nexum_quick_compact_background"
    android:padding="10dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/studyWidgetSwitchLeft"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#D9BCFF"
            android:textSize="24sp"
            android:contentDescription="Vista anterior" />
        <TextView
            android:id="@+id/studyWidgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ESTUDIO"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#D9BCFF" />
        <TextView
            android:id="@+id/studyWidgetSwitchRight"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="›"
            android:textColor="#D9BCFF"
            android:textSize="24sp"
            android:contentDescription="Vista siguiente" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/studyWidgetStudyPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <Chronometer
            android:id="@+id/studyWidgetStudyClock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="29sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-light"
            android:textColor="#FFFFFF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/studyWidgetStudyButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_nexum_quick_button"
                android:gravity="center"
                android:text="Iniciar"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/studyWidgetSave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_today_section_dark"
                android:gravity="center"
                android:text="Guardar tiempo"
                android:textSize="12sp"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/studyWidgetPomodoroPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <Chronometer
            android:id="@+id/studyWidgetPomodoroClock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/studyWidgetPomodoroMeta"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="#D9BCFF"
            android:text="25 min · no suma estudio" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/studyWidgetPomodoroButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_nexum_quick_button"
                android:gravity="center"
                android:text="Iniciar"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/studyWidgetPomodoroReset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_today_section_dark"
                android:gravity="center"
                android:text="Reiniciar"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/studyWidgetHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="#D9BCFF"
            android:text="NEXUM · Inicio"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/studyWidgetPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="● ○"
            android:textColor="#B46BFF"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/studyWidgetOpen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|right"
            android:text="Reloj ↗"
            android:textColor="#D9BCFF"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
